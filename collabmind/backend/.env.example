# Backend Environment Variables
PORT=8080
ENVIRONMENT=development
DEBUG=True

# Google Gemini API Key (optional for live Gemini multi-agent analysis; fallback active if empty)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin Configuration (optional in development mode)
FIREBASE_PROJECT_ID=collabmind-app
FIREBASE_CREDENTIALS_PATH=

# Google Cloud & Vertex AI (optional in development mode)
GCP_PROJECT_ID=collabmind-app
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-1.5-flash-001
